{
  "name": "消息发送（修改 target 为接收 PID）",
  "format": "nest-1",
  "code": [
    [
      "set",
      "target",
      1
    ],
    [
      "set",
      "i",
      0
    ],
    [
      "label",
      "loop"
    ],
    [
      "send",
      "$target",
      "来自发送进程的问候"
    ],
    [
      "add",
      "i",
      1
    ],
    [
      "wait",
      0.5
    ],
    [
      "if",
      [
        "<",
        "$i",
        5
      ],
      "loop"
    ],
    [
      "halt"
    ]
  ]
}