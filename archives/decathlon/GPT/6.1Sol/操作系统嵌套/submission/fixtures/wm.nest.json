{
  "format": "nest-1",
  "name": "窗口管理与输入路由",
  "policy": {
    "stack": "last",
    "focus": "clicked",
    "hit": "top"
  },
  "code": [
    [
      "call",
      "display.desktop",
      null
    ],
    [
      "call",
      "program.policy",
      "policy"
    ],
    [
      "label",
      "loop"
    ],
    [
      "recv",
      "event"
    ],
    [
      "if",
      [
        "==",
        "$event.type",
        "input"
      ],
      "input"
    ],
    [
      "if",
      [
        "==",
        "$event.action",
        "open"
      ],
      "open"
    ],
    [
      "if",
      [
        "==",
        "$event.action",
        "patch"
      ],
      "patch"
    ],
    [
      "if",
      [
        "==",
        "$event.action",
        "close"
      ],
      "close"
    ],
    [
      "if",
      [
        "==",
        "$event.action",
        "new-system"
      ],
      "new-system"
    ],
    [
      "label",
      "focus"
    ],
    [
      "set",
      "target",
      "$event.windowId"
    ],
    [
      "if",
      [
        "==",
        "$policy.focus",
        "first"
      ],
      "first"
    ],
    [
      "jump",
      "apply-focus"
    ],
    [
      "label",
      "first"
    ],
    [
      "call",
      "window.list",
      "windows"
    ],
    [
      "set",
      "target",
      [
        "at",
        "$windows",
        0
      ]
    ],
    [
      "label",
      "apply-focus"
    ],
    [
      "call",
      "window.focus",
      null,
      "$target"
    ],
    [
      "if",
      [
        "==",
        "$policy.stack",
        "first"
      ],
      "lower"
    ],
    [
      "call",
      "window.raise",
      null,
      "$target"
    ],
    [
      "jump",
      "loop"
    ],
    [
      "label",
      "lower"
    ],
    [
      "call",
      "window.lower",
      null,
      "$target"
    ],
    [
      "jump",
      "loop"
    ],
    [
      "label",
      "input"
    ],
    [
      "set",
      "target",
      "$event.windowId"
    ],
    [
      "if",
      [
        "==",
        "$policy.hit",
        "bottom"
      ],
      "hit-bottom"
    ],
    [
      "jump",
      "deliver"
    ],
    [
      "label",
      "hit-bottom"
    ],
    [
      "call",
      "window.list",
      "windows"
    ],
    [
      "set",
      "target",
      [
        "at",
        "$windows",
        0
      ]
    ],
    [
      "label",
      "deliver"
    ],
    [
      "call",
      "window.info",
      "window",
      "$target"
    ],
    [
      "if",
      [
        "==",
        "$window",
        null
      ],
      "loop"
    ],
    [
      "call",
      "message.deliver",
      null,
      0,
      "$window.pid",
      "$event"
    ],
    [
      "jump",
      "loop"
    ],
    [
      "label",
      "open"
    ],
    [
      "call",
      "window.open",
      null,
      "$event.appId",
      "$event.extra"
    ],
    [
      "jump",
      "loop"
    ],
    [
      "label",
      "patch"
    ],
    [
      "call",
      "window.patch",
      null,
      "$event.windowId",
      "$event.patch"
    ],
    [
      "jump",
      "loop"
    ],
    [
      "label",
      "close"
    ],
    [
      "call",
      "window.close",
      null,
      "$event.windowId"
    ],
    [
      "jump",
      "loop"
    ],
    [
      "label",
      "new-system"
    ],
    [
      "call",
      "system.create",
      "child"
    ],
    [
      "call",
      "system.post",
      null,
      "$child",
      [
        "literal",
        {
          "type": "window",
          "action": "open",
          "appId": "player",
          "extra": {}
        }
      ]
    ],
    [
      "jump",
      "loop"
    ]
  ]
}