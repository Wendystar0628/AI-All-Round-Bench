{
  "version": 1,
  "launch": {
    "command": "npm",
    "args": ["start", "--", "--data-dir", "{dataDir}", "--width", "{width}", "--height", "{height}", "--remote-debugging-port={port}"],
    "cwd": "."
  },
  "mainWindow": { "title": "Nested OS" },
  "benchmark": "Electron renderer window.bench: await window.bench.ready(), reset(), inspect()",
  "fixtures": {
    "outer": { "workbook": "/Demo/sample.sheet", "chartRange": "A1:D4", "helicopter": "/Demo/helicopter-24.scene", "documents": "/Documents", "kernel": "/Kernel/kernel.nos", "programs": "/Programs" },
    "inner": { "helicopter": "/Demo/helicopter-24.scene", "documents": "/Documents", "kernel": "/Kernel/kernel.nos", "programs": "/Programs" }
  }
}
