fn fib(n) { if (n < 2) { return n; } return fib(n - 1) + fib(n - 2); }
let sum = 0;
for (let i = 1; i <= 100; i++) { sum += i; }
print("sum=" + sum);
print(fib(15));
let m = {a: 1, "b c": [1, 2, 3], d: {x: 5}};
m.a += 10; m["b c"][1] = 99; m.d.x++;
print(m);
let arr = [];
for (let k of [3, 1, 2]) { push(arr, k * 2); }
print(arr);
for (let k in {p: 1, q: 2}) { print(k); }
let f = fn(a, b) { return a * b; };
print(f(6, 7));
let g = &fib;
print(g(10));
let n = 0;
while (true) { n++; if (n > 5) { break; } if (n % 2 == 0) { continue; } print("odd " + n); }
print(n > 3 ? "big" : "small");
print(1 < 2 && 2 < 3 || false);
print(len("héllo") + len([1,2]));
