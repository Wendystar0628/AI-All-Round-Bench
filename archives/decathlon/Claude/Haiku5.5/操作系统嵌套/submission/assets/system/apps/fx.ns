// =====================================================================
// 环境特效进程（/System/apps/fx.ns）：烟尘、残骸与旋翼下洗的尘土。
// 特效是时刻的确定函数：同一时刻、同一状态得到同样的粒子，因此跳转与逐帧后画面只取决于当前时刻。
// 消息 frame(st, t)：回复 fx（粒子列表）。
// =====================================================================
func rnd(i, s) {
    var x = sin(i * 12.9898 + s * 78.233) * 43758.5453;
    return x - floor(x);
}

func debris(st, t, wind) {
    var out = [];
    if (!st.crashed) { return out; }
    var cp = st.crashPos;
    var tau = t - st.crashT;
    if (tau < 0) { return out; }
    var ground = cp[1] - 0.2;
    for (var i = 0; i < 36; i = i + 1) {
        var r1 = rnd(i, 1);
        var r2 = rnd(i, 2);
        var r3 = rnd(i, 3);
        var r4 = rnd(i, 4);
        var vx = st.crashVel[0] * 0.25 + (r4 - 0.5) * 7;
        var vz = st.crashVel[2] * 0.25 + (r2 - 0.5) * 7;
        var vy = 2 + r1 * 6;
        var fall = 1 - exp(-tau * 2.2);
        var x = cp[0] + (r3 - 0.5) * 2.5 + vx * fall * 0.5;
        var z = cp[2] + (r1 - 0.5) * 2.5 + vz * fall * 0.5;
        var y = cp[1] + 0.4 + vy * tau - 4.9 * tau * tau;
        var size = 0.35 + r2 * 0.6;
        if (y < ground + size * 0.5) { y = ground + size * 0.5; }
        var rot = tau * (2 + r3 * 5);
        if (tau > 1.2) { rot = 1.2 * (2 + r3 * 5); }
        push(out, {p: [x, y, z], s: [size * 1.4, size * 0.5, size], r: rot + r4 * 6, k: i % 3});
    }
    return out;
}

func smoke(st, t, wind) {
    var out = [];
    if (!st.crashed) { return out; }
    var cp = st.crashPos;
    for (var i = 0; i < 48; i = i + 1) {
        var born = st.crashT + i * 0.12;
        var a = t - born;
        if (a < 0 || a > 7.5) { continue; }
        var r1 = rnd(i + 100, 1);
        var r2 = rnd(i + 100, 2);
        var x = cp[0] + wind[0] * a * 0.6 + (r1 - 0.5) * 2.4;
        var y = cp[1] + 0.8 + a * 1.1 + a * a * 0.02;
        var z = cp[2] + wind[1] * a * 0.6 + (r2 - 0.5) * 2.4;
        var size = 2 + a * 1.9;
        var alpha = 0.78 - a / 10;
        if (alpha < 0) { alpha = 0; }
        push(out, {p: [x, y, z], s: size, a: alpha, g: 0.25 + r1 * 0.25});
    }
    // 残骸处的火光：几处闪烁的小火苗
    if (t - st.crashT < 6) {
        for (var f = 0; f < 5; f = f + 1) {
            var fl = 0.6 + 0.4 * sin(t * 18 + f * 2.1);
            push(out, {p: [cp[0] + (f - 2) * 0.9, cp[1] + 0.6 + f * 0.1, cp[2] + (f % 2) * 0.8], s: 1.2 + f * 0.1, a: fl * (1 - (t - st.crashT) / 6), g: -1});
        }
    }
    return out;
}

// 旋翼下洗：低空时从旋翼圆盘向外卷起的尘土
func dust(st, t, wind) {
    var out = [];
    if (st.crashed || st.alt > 8 || st.rotor < 0.6) { return out; }
    var gh = st.gh;
    var step = 0.04;
    var k0 = floor(t / step);
    for (var i = 0; i < 30; i = i + 1) {
        var k = k0 - i;
        var born = k * step;
        var a = t - born;
        if (a < 0 || a > 1.3) { continue; }
        var ang = rnd(k, 7) * 6.2831853;
        var rad = 3.2 + a * 6.5;
        var x = st.p[0] + cos(ang) * rad + wind[0] * a * 0.4;
        var z = st.p[2] + sin(ang) * rad + wind[1] * a * 0.4;
        var y = gh + 0.25 + a * 0.7;
        push(out, {p: [x, y, z], s: 1.4 + a * 1.2, a: (1.3 - a) * 0.45});
    }
    return out;
}

func main(args) {
    while (true) {
        var m = sys_recv();
        if (m.type == "frame") {
            var st = m.st;
            var t = m.t;
            var fx = {debris: debris(st, t, st.wind), smoke: smoke(st, t, st.wind), dust: dust(st, t, st.wind)};
            sys_send(m.reply, {type: "fx", fx: fx, t: t});
        }
    }
    return 0;
}
