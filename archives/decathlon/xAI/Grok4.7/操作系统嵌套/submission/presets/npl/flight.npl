# 飞控。读传感器，写总距和舵面。错过的周期不补算，上一次指令保持到下一次。
# 传感器字段：t x y z vx vy vz roll pitch yaw rr pr yr rpm tx ty tz heading wind fault crashed
# 指令：collective（0 到 1）、roll、pitch、yaw（约 -1 到 1）
# 机体有常值滚转力矩。杆量长时间为零，姿态会散。

fn main() {
  let physics = 0;
  let timeline = 0;
  let cmd = { tag: "cmd", collective: 0.46, roll: -0.12, pitch: 0, yaw: 0 };
  while (true) {
    let m = wait_msg();
    if (m != null && m.tag == "boot") {
      physics = m.physics;
      if (m.timeline != null) { timeline = m.timeline; }
    }
    if (m != null && m.tag == "sense") { cmd = control(m); }
    let g = 0;
    while (g < 6) {
      let e = recv();
      if (e == null) { g = 100; }
      else {
        if (e.tag == "boot") {
          physics = e.physics;
          if (e.timeline != null) { timeline = e.timeline; }
        }
        if (e.tag == "sense") { cmd = control(e); }
        g = g + 1;
      }
    }
    if (physics != 0) { send(physics, cmd); }
    if (timeline != 0) {
      send(timeline, { tag: "cmd", t: clock(), collective: cmd.collective, roll: cmd.roll, pitch: cmd.pitch, yaw: cmd.yaw });
    }
  }
}

fn wrap(a) {
  let v = a;
  while (v > 3.14159265) { v = v - 6.2831853; }
  while (v < -3.14159265) { v = v + 6.2831853; }
  return v;
}

fn clamp(v, a, b) {
  if (v < a) { return a; }
  if (v > b) { return b; }
  return v;
}

fn control(s) {
  if (s.crashed != null && s.crashed != 0) {
    return { tag: "cmd", collective: 0, roll: 0, pitch: 0, yaw: 0 };
  }
  let alt = s.ty - s.y;
  let col = 9.8 / 21.5 + alt * 0.05 - s.vy * 0.09;
  let nx = -cos(s.pitch) * sin(s.yaw);
  let nz = -cos(s.pitch) * cos(s.yaw);
  let ex = s.tx - s.x;
  let ez = s.tz - s.z;
  let fwd = ex * nx + ez * nz;
  let right = ex * (-nz) + ez * nx;
  let pitch = clamp(fwd * 0.03 - (s.vx * nx + s.vz * nz) * 0.07 - s.pitch * 1.6 - s.pr * 0.55, -0.35, 0.35);
  let roll = clamp(right * 0.03 - s.roll * 1.6 - s.rr * 0.55 - 0.12, -0.4, 0.4);
  let yaw = clamp(wrap(s.heading - s.yaw) * 0.85 - s.yr * 0.35, -0.8, 0.8);
  return { tag: "cmd", collective: clamp(col, 0, 1), roll: roll, pitch: pitch, yaw: yaw };
}
