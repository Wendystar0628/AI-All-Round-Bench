# 飞行物理。不稳定，按虚拟时间积分，不等待飞控。画面停在已经算完的时刻。
# 姿态约定与显示设备一致：Euler(-pitch, yaw, -roll)，顺序 YXZ。机头是局部 -Z。

fn main() {
  let s = fresh();
  let cmd = { collective: 0.46, roll: -0.12, pitch: 0, yaw: 0 };
  let stage = 0;
  let fx = 0;
  let flight = 0;
  let allow = 0;
  let last = clock();
  while (true) {
    let m = wait_msg();
    let pack = eat(s, cmd, stage, fx, flight, allow, m);
    s = pack.s; cmd = pack.cmd; stage = pack.stage; fx = pack.fx; flight = pack.flight; allow = pack.allow;
    let g = 0;
    while (g < 8) {
      let e = recv();
      if (e == null) { g = 100; }
      else {
        pack = eat(s, cmd, stage, fx, flight, allow, e);
        s = pack.s; cmd = pack.cmd; stage = pack.stage; fx = pack.fx; flight = pack.flight; allow = pack.allow;
        g = g + 1;
      }
    }
    if (allow == 1) {
      let now = clock();
      let dt = now - last;
      if (dt < 0) { dt = 0; }
      let steps = 0;
      while (dt >= 50 && steps < 6) {
        integrate(s, cmd, 0.05);
        dt = dt - 50;
        steps = steps + 1;
      }
      last = now;
    } else {
      last = clock();
    }
    emit(s, stage, fx, flight);
  }
}

fn fresh() {
  return {
    x: 0, y: 1.1, z: 0, vx: 0, vy: 0, vz: 0,
    roll: 0, pitch: 0, yaw: 0, rr: 0, pr: 0, yr: 0,
    rpm: 1, wind: 0, fault: 0, sim: 0, crashed: 0, damage: 0, crashAge: -1,
    tx: 34, ty: 8, tz: -16, heading: 0.6,
    cx: 8, cy: 6, cz: 14, lx: 0, ly: 1, lz: 0
  };
}

fn eat(s, cmd, stage, fx, flight, allow, m) {
  if (m == null) { return pack(s, cmd, stage, fx, flight, allow); }
  if (m.tag == "boot" || m.tag == "init") {
    if (m.stage != null) { stage = m.stage; }
    if (m.fx != null) { fx = m.fx; }
    if (m.flight != null) { flight = m.flight; }
    if (m.timeline != null) { s.who = m.timeline; }
  }
  if (m.tag == "init") {
    if (m.x != null) { s.x = m.x; s.y = m.y; s.z = m.z; }
    if (m.roll != null) { s.roll = m.roll; s.pitch = m.pitch; s.yaw = m.yaw; }
    s.rr = 0; s.pr = 0; s.yr = 0;
    if (m.vx != null) { s.vx = m.vx; s.vy = m.vy; s.vz = m.vz; }
    else { s.vx = 0; s.vy = 0; s.vz = 0; }
    if (m.rpm != null) { s.rpm = m.rpm; } else { s.rpm = 1; }
    if (m.sim != null) { s.sim = m.sim; } else { s.sim = 0; }
    if (m.damage != null) { s.damage = m.damage; s.crashed = m.crashed; }
    else { s.crashed = 0; s.damage = 0; s.crashAge = -1; }
    if (m.tx != null) { s.tx = m.tx; s.ty = m.ty; s.tz = m.tz; }
    if (m.heights != null) {
      s.heights = m.heights; s.nx = m.nx; s.nz = m.nz; s.ox = m.ox; s.oz = m.oz; s.step = m.step;
    }
    if (m.pads != null) { s.pads = m.pads; }
    if (m.blocks != null) { s.blocks = m.blocks; }
  }
  if (m.tag == "nudge") { integrate(s, cmd, 0.05); }
  if (m.tag == "goal") {
    if (m.tx != null) { s.tx = m.tx; s.ty = m.ty; s.tz = m.tz; }
    if (m.heading != null) { s.heading = m.heading; }
    if (m.wind != null) { s.wind = m.wind; }
    if (m.fault != null) { s.fault = m.fault; }
    if (m.allow != null) { allow = m.allow; }
  }
  if (m.tag == "cam") {
    s.cx = m.cx; s.cy = m.cy; s.cz = m.cz; s.lx = m.lx; s.ly = m.ly; s.lz = m.lz;
  }
  if (m.tag == "cmd") { cmd = m; }
  return pack(s, cmd, stage, fx, flight, allow);
}

fn pack(s, cmd, stage, fx, flight, allow) {
  return { s: s, cmd: cmd, stage: stage, fx: fx, flight: flight, allow: allow };
}

fn emit(s, stage, fx, flight) {
  let pose = {
    tag: "pose", t: s.sim, x: s.x, y: s.y, z: s.z, vx: s.vx, vy: s.vy, vz: s.vz,
    roll: s.roll, pitch: s.pitch, yaw: s.yaw, rpm: s.rpm, rotor: s.sim * s.rpm * 24,
    damage: s.damage, dust: dust_of(s), smoke: smoke_of(s), fire: fire_of(s), crashAge: s.crashAge,
    cam: [s.cx, s.cy, s.cz], look: [s.lx, s.ly, s.lz], mode: "live"
  };
  if (stage != 0) { send(stage, pose); }
  if (fx != 0) {
    send(fx, {
      tag: "fx", t: s.sim, x: s.x, y: s.y, z: s.z, rpm: s.rpm, damage: s.damage,
      crashAge: s.crashAge, dust: dust_of(s), smoke: smoke_of(s), fire: fire_of(s), crashT: 0
    });
  }
  if (flight != 0) {
    send(flight, {
      tag: "sense", t: s.sim, x: s.x, y: s.y, z: s.z, vx: s.vx, vy: s.vy, vz: s.vz,
      roll: s.roll, pitch: s.pitch, yaw: s.yaw, rr: s.rr, pr: s.pr, yr: s.yr, rpm: s.rpm,
      tx: s.tx, ty: s.ty, tz: s.tz, heading: s.heading, wind: s.wind, fault: s.fault, crashed: s.crashed
    });
  }
  if (s.who != null && s.who != 0) { send(s.who, pose); }
  return 0;
}

fn dust_of(s) {
  let h = s.y - ground(s, s.x, s.z);
  if (h < 0) { h = 0; }
  if (h > 8) { return 0; }
  return s.rpm * (1 - h / 8);
}

fn smoke_of(s) {
  if ((s.fault > 0 && s.sim >= s.fault) || s.damage > 0) { return 0.4 + s.damage; }
  return 0;
}

fn fire_of(s) {
  if (s.damage >= 1) { return 1; }
  return 0;
}

fn integrate(s, cmd, dt) {
  let col = 0.46;
  let cr = -0.12;
  let cp = 0;
  let cy = 0;
  if (cmd != null && cmd.collective != null) {
    col = cmd.collective; cr = cmd.roll; cp = cmd.pitch; cy = cmd.yaw;
  }
  let rpmT = 1;
  if (s.fault > 0 && s.sim >= s.fault) { rpmT = 0.28; }
  s.rpm = s.rpm + (rpmT - s.rpm) * 1.4 * dt;
  if (s.rpm < 0) { s.rpm = 0; }
  let lift = s.rpm * s.rpm * col * 21.5;
  if (lift < 0) { lift = 0; }
  let upx = -sin(s.yaw) * cos(s.roll) * sin(s.pitch) + cos(s.yaw) * sin(s.roll);
  let upy = cos(s.pitch) * cos(s.roll);
  let upz = -sin(s.yaw) * sin(s.roll) - cos(s.yaw) * cos(s.roll) * sin(s.pitch);
  s.vx = s.vx + (upx * lift + s.wind) * dt;
  s.vy = s.vy + (upy * lift - 9.8) * dt;
  s.vz = s.vz + (upz * lift) * dt;
  s.vx = s.vx * exp_drag(0.45, dt);
  s.vz = s.vz * exp_drag(0.45, dt);
  s.rr = s.rr + (cr * 3.2 + s.roll * 0.85 + 0.35 - s.rr * 1.1) * dt;
  s.pr = s.pr + (cp * 3.2 + s.pitch * 0.85 - s.pr * 1.1) * dt;
  s.yr = s.yr + (cy * 1.8 - s.yr * 0.8) * dt;
  s.roll = s.roll + s.rr * dt;
  s.pitch = s.pitch + s.pr * dt;
  s.yaw = s.yaw + s.yr * dt;
  s.x = s.x + s.vx * dt;
  s.y = s.y + s.vy * dt;
  s.z = s.z + s.vz * dt;
  let gy = ground(s, s.x, s.z) + 0.55;
  if (s.y < gy) {
    if (s.vy < -3.2) { s.crashed = 1; s.damage = 1; }
    s.y = gy;
    s.vy = 0;
    s.vx = s.vx * 0.5;
    s.vz = s.vz * 0.5;
    s.roll = s.roll * 0.85;
    s.pitch = s.pitch * 0.85;
  }
  hit_blocks(s);
  if (s.crashed != 0) {
    if (s.crashAge < 0) { s.crashAge = 0; }
    s.crashAge = s.crashAge + dt;
    s.damage = 1;
  }
  s.sim = s.sim + dt;
  return 0;
}

fn ground(s, x, z) {
  let h = sin(x * 0.09) * 0.55 + cos(z * 0.07) * 0.4;
  if (s.heights != null && s.nx > 1 && s.step > 0) { h = sample_h(s, x, z); }
  if (s.pads != null) {
    let i = 0;
    while (i < len(s.pads)) {
      let p = s.pads[i];
      let dx = x - p.x;
      let dz = z - p.z;
      if (dx * dx + dz * dz < p.r * p.r) { h = p.y; }
      i = i + 1;
    }
  } else {
    if (x * x + z * z < 49) { h = 0.15; }
    let dx2 = x - 34;
    let dz2 = z + 16;
    if (dx2 * dx2 + dz2 * dz2 < 49) { h = 0.15; }
  }
  return h;
}

fn sample_h(s, x, z) {
  let gx = floor((x - s.ox) / s.step);
  let gz = floor((z - s.oz) / s.step);
  if (gx < 0) { gx = 0; }
  if (gz < 0) { gz = 0; }
  if (gx >= s.nx) { gx = s.nx - 1; }
  if (gz >= s.nz) { gz = s.nz - 1; }
  let idx = gz * s.nx + gx;
  if (idx < 0 || idx >= len(s.heights)) { return 0; }
  return s.heights[idx];
}

fn hit_blocks(s) {
  if (s.blocks == null) {
    if (s.x > 13 && s.x < 19 && s.z > 7 && s.z < 13 && s.y < 7) {
      s.crashed = 1;
      s.damage = 1;
      s.vx = 0;
      s.vz = 0;
    }
    return 0;
  }
  let i = 0;
  while (i < len(s.blocks)) {
    let o = s.blocks[i];
    if (s.x > o.x - o.w && s.x < o.x + o.w && s.z > o.z - o.d && s.z < o.z + o.d && s.y < o.h) {
      s.crashed = 1;
      s.damage = 1;
      s.vx = 0;
      s.vz = 0;
    }
    i = i + 1;
  }
  return 0;
}

fn exp_drag(k, dt) {
  let x = -k * dt;
  return 1 + x + x * x * 0.5;
}
